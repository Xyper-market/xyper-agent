# Core Xyper API settings
XYPER_API_BASE=https://api-staging.xyper.market
XYPER_APP_BASE_URL=https://app-staging.xyper.market

# Wallet used for auth, onchain approval, and reward claims.
# Must hold enough native gas token on every target chain.
# Supported formats for env-key-wallet-flow:
# - EVM private key: 0x-prefixed hex
# - Solana secret key: JSON array, base58, or base64 encoded 64-byte secret key
WALLET_PRIVATE_KEY=0xREPLACE_ME
# Example Solana JSON-array secret key:
# WALLET_PRIVATE_KEY=[12,34,56,...]
# Example Solana base58 secret key:
# WALLET_PRIVATE_KEY=3vQ8...

# Runtime-generated token returned by wallet_auth.js.
# Usually do not prefill this in a committed .env file.
XYPER_AGENT_TOKEN=

# Chain RPC map used by onchain helpers.
# Include every chain id your agent may receive in auth/onchain/claim intents.
# Example:
# - 900001 = Solana Devnet
# - 84532  = Base Sepolia
RPC_URLS={"900001":"https://api.devnet.solana.com","84532":"https://base-sepolia.gateway.tenderly.co"}

# Optional runtime labels
XYPER_ENV=staging
XYPER_OWNER_LABEL=xyper-staging

# Optional referral onboarding
# If the wallet is brand new and should register under a referral link/code,
# put the code here and pass it into wallet_auth.js during first verify only.
XYPER_REFERRAL_CODE=

# X mode A: official API credentials (preferred)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# X mode B: login/password fallback
X_USERNAME=
X_LOGIN_PASSWORD=
X_EMAIL=
X_LOGIN_2FA_SECRET=
X_COOKIE_PATH=/opt/openclaw/config/xyper-staging-x-cookies.json
X_BROWSER_LOGIN_URL=https://x.com/i/flow/login
X_BROWSER_PROFILE_DIR=/opt/openclaw/config/xyper-staging-x-browser-profile

# X mode C: reuse an existing user browser session
# Preferred: pass the full cookie set as JSON.
X_COOKIES_JSON=
# Minimal fallback: pass only the two core cookies.
# Copy from browser devtools only if you trust the runtime with full account session cookies.
X_AUTH_TOKEN=
X_CT0=

# Optional future email-code helper settings
X_EMAIL_MODE=
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASSWORD=
X_EMAIL_FROM_FILTER=
X_EMAIL_SUBJECT_FILTER=
